# Local lab configuration. Override any value in on-prem/.env (gitignored).

# kind cluster
CLUSTER_NAME=gitops-local
# Linkerd edge-26.x supports Kubernetes <= 1.35
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
# Hard cap for the kind node container so the lab cannot starve other containers
# on this machine. Everything in the cluster shares this budget.
KIND_NODE_CPUS=4
KIND_NODE_MEMORY=4g

# Host ports mapped to ingress-nginx (http://<name>.localtest.me)
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localtest.me

# Local image registry (host: localhost:5001, inside the cluster: kind-registry:5000)
REGISTRY_NAME=kind-registry
REGISTRY_PORT=5001

# Git repository ArgoCD deploys from and Jenkins builds/pushes to
GIT_REPO_URL=https://github.com/khiem20tc/k8s-helm-linkerd-jenkins-argoCD.git
GIT_REVISION=main

# Environments deployed by ArgoCD (space separated: dev staging prod)
ENVIRONMENTS="dev"

# Optional components
ENABLE_LINKERD_VIZ=true
ENABLE_JENKINS=true
ENABLE_MONITORING=false

# Tool versions (downloaded into on-prem/.bin, nothing is installed system-wide)
KIND_VERSION=v0.33.0
HELM_VERSION=v3.22.0
LINKERD_VERSION=edge-26.9.3
GATEWAY_API_VERSION=v1.5.1
INGRESS_NGINX_CHART_VERSION=4.15.1
METRICS_SERVER_CHART_VERSION=3.14.0
ARGOCD_CHART_VERSION=10.9.2
JENKINS_CHART_VERSION=5.9.64
KUBE_PROMETHEUS_CHART_VERSION=91.5.2
