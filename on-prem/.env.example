# Copy to on-prem/.env (gitignored) and fill in.
# GitHub account + token with push access to GIT_REPO_URL, used by Jenkins to
# commit the new image tag to k8s/helm/user-service/values-<env>.yaml.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Examples of overrides:
# GIT_REVISION=feature/on-prem
# ENVIRONMENTS="dev staging prod"
# HTTP_PORT=8088
