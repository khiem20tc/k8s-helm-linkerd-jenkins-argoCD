// CI pipeline for user-service.
//
// GitOps flow: Jenkins builds, tests and pushes an immutable image, then commits
// the new image tag to k8s/helm/user-service/values-<env>.yaml. ArgoCD watches
// that file and performs the actual deployment. Jenkins never deploys directly.
//
// Required Jenkins credentials:
//   git-credentials   Username/password (or token) allowed to push to this repo
//   argocd-token      Secret text: ArgoCD API token (read access to the apps)
// Required Kubernetes secret in the agent namespace:
//   registry-credentials  type kubernetes.io/dockerconfigjson, used by kaniko to push
//
// Optional global environment variables (set by on-prem/values/jenkins.yaml for the local lab):
//   CI_REGISTRY           Registry to push to (default: your-registry.com)
//   CI_KANIKO_EXTRA_ARGS  Extra kaniko flags, e.g. "--insecure" for a plain HTTP registry
//   CI_ARGOCD_OPTS        argocd CLI flags (default: --grpc-web --insecure)
//   CI_GIT_BRANCH         Branch that holds the GitOps manifests (default: main)

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: golang
      image: golang:1.23
      command: ["cat"]
      tty: true
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["/busybox/cat"]
      tty: true
      volumeMounts:
        - name: registry-credentials
          mountPath: /kaniko/.docker
    - name: argocd
      image: quay.io/argoproj/argocd:v2.12.4
      command: ["cat"]
      tty: true
  volumes:
    - name: registry-credentials
      secret:
        secretName: registry-credentials
        items:
          - key: .dockerconfigjson
            path: config.json
'''
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        DOCKER_REGISTRY = "${env.CI_REGISTRY ?: 'your-registry.com'}"
        KANIKO_EXTRA_ARGS = "${env.CI_KANIKO_EXTRA_ARGS ?: ''}"
        IMAGE_NAME = 'user-service'
        GIT_BRANCH_TARGET = "${env.CI_GIT_BRANCH ?: 'main'}"
        ARGOCD_SERVER = 'argocd-server.argocd.svc.cluster.local'
        // argocd-server uses a self-signed certificate by default
        ARGOCD_OPTS = "${env.CI_ARGOCD_OPTS ?: '--grpc-web --insecure'}"
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Target environment')
        string(name: 'VERSION', defaultValue: '', description: 'Existing image tag to promote. Leave empty to build a new image from this commit.')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip unit tests and security scan')
    }

    stages {
        stage('Checkout') {
            steps {
                container('golang') {
                    script {
                        // The workspace is owned by the Jenkins agent user, not root
                        sh 'git config --global --add safe.directory "$WORKSPACE"'

                        // Commits pushed by this pipeline are tagged [skip ci] to avoid a build loop
                        def lastMessage = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
                        env.SKIP_CI = lastMessage.contains('[skip ci]') ? 'true' : 'false'
                        if (env.SKIP_CI == 'true') {
                            currentBuild.result = 'NOT_BUILT'
                            currentBuild.description = 'Skipped: [skip ci] commit'
                        }

                        env.BUILD_IMAGE = params.VERSION ? 'false' : 'true'
                        env.VERSION = params.VERSION ?: sh(
                            script: 'git describe --tags --always',
                            returnStdout: true
                        ).trim()
                        env.DOCKER_IMAGE = "${env.DOCKER_REGISTRY}/${env.IMAGE_NAME}:${env.VERSION}"
                        echo "Image: ${env.DOCKER_IMAGE} (build: ${env.BUILD_IMAGE}), environment: ${params.ENVIRONMENT}"
                    }
                }
            }
        }

        stage('CI/CD') {
            when {
                expression { env.SKIP_CI != 'true' }
            }
            stages {
                stage('Unit Tests') {
                    when {
                        expression { env.BUILD_IMAGE == 'true' && !params.SKIP_TESTS }
                    }
                    steps {
                        container('golang') {
                            dir('app') {
                                sh '''
                                    go mod download
                                    go mod verify

                                    echo "Running go vet..."
                                    go vet ./...

                                    echo "Checking formatting..."
                                    unformatted=$(gofmt -s -l .)
                                    if [ -n "$unformatted" ]; then
                                        echo "Code is not formatted. Run 'gofmt -s -w .' on:"
                                        echo "$unformatted"
                                        exit 1
                                    fi

                                    echo "Running tests..."
                                    go test -race -v ./...
                                '''
                            }
                        }
                    }
                }

                stage('Security Scan') {
                    when {
                        expression { env.BUILD_IMAGE == 'true' && !params.SKIP_TESTS }
                    }
                    steps {
                        container('golang') {
                            dir('app') {
                                sh '''
                                    go install github.com/securego/gosec/v2/cmd/gosec@v2.21.4
                                    gosec -exclude-generated -fmt json -out gosec-report.json -stdout -verbose=text ./...
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'app/gosec-report.json', allowEmptyArchive: true
                        }
                    }
                }

                stage('Build & Push Image') {
                    when {
                        expression { env.BUILD_IMAGE == 'true' }
                    }
                    steps {
                        container('kaniko') {
                            sh '''
                                /kaniko/executor \
                                    --context "$WORKSPACE/app" \
                                    --dockerfile "$WORKSPACE/app/Dockerfile" \
                                    --destination "$DOCKER_IMAGE" \
                                    --cache=true \
                                    $KANIKO_EXTRA_ARGS
                            '''
                        }
                    }
                }

                stage('Approve Production') {
                    when {
                        expression { params.ENVIRONMENT == 'prod' }
                    }
                    steps {
                        timeout(time: 1, unit: 'HOURS') {
                            input message: "Deploy ${env.DOCKER_IMAGE} to production?", ok: 'Deploy'
                        }
                    }
                }

                stage('Update GitOps Manifest') {
                    when {
                        // Multibranch jobs only deploy from the main branch
                        expression { !env.BRANCH_NAME || env.BRANCH_NAME == env.GIT_BRANCH_TARGET }
                    }
                    steps {
                        container('golang') {
                            withCredentials([gitUsernamePassword(credentialsId: 'git-credentials', gitToolName: 'Default')]) {
                                sh '''
                                    VALUES_FILE="k8s/helm/user-service/values-${ENVIRONMENT}.yaml"

                                    git config user.name "jenkins-ci"
                                    git config user.email "jenkins-ci@users.noreply.github.com"

                                    git fetch origin "$GIT_BRANCH_TARGET"
                                    git checkout -B "$GIT_BRANCH_TARGET" "origin/$GIT_BRANCH_TARGET"

                                    # values-<env>.yaml only has one "  tag:" line (image.tag)
                                    sed -i -E "s|^(  tag: ).*|\\1\\"${VERSION}\\"|" "$VALUES_FILE"
                                    grep -n '  tag:' "$VALUES_FILE"

                                    if git diff --quiet -- "$VALUES_FILE"; then
                                        echo "${ENVIRONMENT} already points at ${VERSION}, nothing to commit"
                                        exit 0
                                    fi

                                    git add "$VALUES_FILE"
                                    git commit -m "deploy(${ENVIRONMENT}): user-service ${VERSION} [skip ci]"

                                    # Retry in case someone pushed in the meantime
                                    for attempt in 1 2 3; do
                                        if git push origin "HEAD:$GIT_BRANCH_TARGET"; then
                                            exit 0
                                        fi
                                        echo "Push rejected (attempt $attempt), rebasing..."
                                        git fetch origin "$GIT_BRANCH_TARGET"
                                        git rebase "origin/$GIT_BRANCH_TARGET"
                                    done
                                    echo "Failed to push GitOps change"
                                    exit 1
                                '''
                            }
                        }
                    }
                }

                stage('Wait for ArgoCD Sync') {
                    when {
                        expression { !env.BRANCH_NAME || env.BRANCH_NAME == env.GIT_BRANCH_TARGET }
                    }
                    steps {
                        container('argocd') {
                            withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
                                sh '''
                                    APP="user-service-${ENVIRONMENT}"

                                    # Pick up the new commit now instead of waiting for the polling interval
                                    argocd app get "$APP" --refresh > /dev/null
                                    argocd app wait "$APP" --sync --health --timeout 600
                                '''
                            }
                        }
                    }
                }

                stage('Smoke Test') {
                    when {
                        expression { !env.BRANCH_NAME || env.BRANCH_NAME == env.GIT_BRANCH_TARGET }
                    }
                    steps {
                        container('golang') {
                            sh '''
                                URL="http://user-service-${ENVIRONMENT}.user-service-${ENVIRONMENT}.svc.cluster.local/health"
                                echo "Checking $URL"
                                curl -fsS --retry 10 --retry-delay 5 --retry-all-errors "$URL"
                                echo
                                echo "Smoke test passed!"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (env.SKIP_CI != 'true' && params.ENVIRONMENT == 'prod') {
                    slackSend(
                        channel: '#deployments',
                        color: 'good',
                        message: "✅ Deployment successful!\n" +
                                "Service: ${env.IMAGE_NAME}\n" +
                                "Version: ${env.VERSION}\n" +
                                "Environment: ${params.ENVIRONMENT}\n" +
                                "Build: ${env.BUILD_URL}"
                    )
                }
            }
        }

        failure {
            slackSend(
                channel: '#deployments',
                color: 'danger',
                message: "❌ Deployment failed!\n" +
                        "Service: ${env.IMAGE_NAME}\n" +
                        "Version: ${env.VERSION}\n" +
                        "Environment: ${params.ENVIRONMENT}\n" +
                        "Build: ${env.BUILD_URL}\n" +
                        "Logs: ${env.BUILD_URL}console"
            )
        }

        cleanup {
            cleanWs()
        }
    }
}
